{
  "name": "ai-form-autofill",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:schema && npm run test:i18n && npm run test:vault && npm run test:api && npm run test:worker && npm run test:checkout-site && npm run test:playwright",
    "test:schema": "node --test tests/schema-engine.test.mjs",
    "test:i18n": "node --test tests/i18n-locales.test.mjs",
    "test:vault": "node --test tests/vault-crypto.test.mjs",
    "test:api": "node --test tests/api-contracts.test.mjs",
    "test:worker": "node --test tests/worker-api.test.mjs",
    "test:playwright": "node tests/playwright-fill-smoke.mjs",
    "test:checkout-site": "node tests/site-checkout-smoke.mjs",
    "test:extension": "node tests/extension-real-browser-e2e.mjs",
    "test:public-probe": "node tests/public-site-real-browser-probe.mjs",
    "dev:schema-proxy": "AFA_SCHEMA_PROXY_MODE=mock node api/schema-proxy/server.mjs",
    "dev:entitlement": "node api/entitlement/server.mjs",
    "setup:stripe:dry": "DRY_RUN=1 node scripts/setup-stripe-products.mjs",
    "setup:stripe": "node scripts/setup-stripe-products.mjs",
    "configure:release": "node scripts/configure-release.mjs",
    "build:vercel-app": "node scripts/build-vercel-app.mjs",
    "deploy:vercel": "npm run build:vercel-app && vercel deploy deploy/formpilot-vault-api --prod --yes --scope daideguchis-projects",
    "deploy:worker": "npx wrangler deploy",
    "d1:migrate:local": "npx wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "npx wrangler d1 migrations apply DB --remote",
    "release:check": "node scripts/release-readiness.mjs",
    "release:check:strict": "node scripts/release-readiness.mjs --strict",
    "check:production": "node scripts/check-production-connections.mjs",
    "check:production:strict-ai": "node scripts/check-production-connections.mjs --strict-ai-live",
    "check:cloudflare": "node scripts/check-cloudflare-readiness.mjs",
    "check:cloudflare:live": "node scripts/check-cloudflare-live.mjs",
    "check:paid-license": "node scripts/check-paid-license-live.mjs",
    "check:launch": "node scripts/check-launch-status.mjs",
    "purchase:verify": "node scripts/run-live-purchase-verification.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "i18n:sync": "node scripts/sync-extension-locales.mjs",
    "assets:store": "node scripts/generate-store-assets.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "preview:shot": "node scripts/generate-product-preview.mjs"
  },
  "devDependencies": {
    "playwright": "^1.59.1",
    "wrangler": "^4.95.0"
  }
}
